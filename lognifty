import numpy as np
import pandas as pd


def calculate_indicators(df):
  # 1. EMA (Exponential Moving Average - 50 और 200 अवधि)
  df['EMA_50'] = df['Close'].ewm(span=50, adjust=False).mean()
  df['EMA_200'] = df['Close'].ewm(span=200, adjust=False).mean()

  # 2. Bollinger Bands (20 अवधि, 2 मानक विचलन)
  df['BB_Middle'] = df['Close'].rolling(window=20).mean()
  std_dev = df['Close'].rolling(window=20).std()
  df['BB_Upper'] = df['BB_Middle'] + (std_dev * 2)
  df['BB_Lower'] = df['BB_Middle'] - (std_dev * 2)

  # 3. RSI (Relative Strength Index - 14 अवधि)
  delta = df['Close'].diff()
  gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
  loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
  rs = gain / loss
  df['RSI'] = 100 - (100 / (1 + rs))

  # 4. SMC Simplified Simulation (Order Block / Break of Structure)
  # हाल ही में उच्च या निम्न स्तर को तोड़ने पर BOS मानेंगे
  df['Higher_High'] = (df['High'] > df['High'].shift(1)) & (
      df['High'].shift(1) > df['High'].shift(2)
  )
  df['Lower_Low'] = (df['Low'] < df['Low'].shift(1)) & (
      df['Low'].shift(1) < df['Low'].shift(2)
  )

  return df


def generate_sentiment(df):
  df = calculate_indicators(df)

  # सेंटीमेंट कॉलम जोड़ें
  df['Sentiment'] = 'NEUTRAL'

  # **Bullish Condition (तेजी का सेंटीमेंट)**:
  # - कीमत Bollinger Band के निचले स्तर के पास हो या उससे बाउंस हो रही हो
  # - RSI 40 से ऊपर हो (oversold से बाहर आ रहा हो)
  # - कीमत EMA 50 से ऊपर हो (ट्रेंड पॉजिटिव)
  # - SMC Bullish Structure (Lower Low बंद होना बंद और Higher High बनना)
  bullish_cond = (
      (df['Close'] <= df['BB_Lower'] * 1.01)
      & (df['RSI'] > 40)
      & (df['Close'] > df['EMA_50'])
      & (df['Higher_High'])
  )

  # **Bearish Condition (मंदी का सेंटीमेंट)**:
  # - कीमत Bollinger Band के ऊपरी स्तर के पास हो
  # - RSI 60 से नीचे हो (overbought से नीचे आ रहा हो)
  # - कीमत EMA 50 से नीचे हो
  # - SMC Bearish Structure (Lower Low बनना)
  bearish_cond = (
      (df['Close'] >= df['BB_Upper'] * 0.99)
      & (df['RSI'] < 60)
      & (df['Close'] < df['EMA_50'])
      & (df['Lower_Low'])
  )

  df.loc[bullish_cond, 'Sentiment'] = 'BULLISH'
  df.loc[bearish_cond, 'Sentiment'] = 'BEARISH'

  return df


# --- उदाहरण के लिए डमी डेटा (Dummy Data) के साथ टेस्ट करने का तरीका ---
