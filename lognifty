import pandas as pd

def calculate_bollinger_bands(data, window=20, num_std=2):
    # सिम्पल मव्हिंग एव्हरेज (SMA) आणि स्टँडर्ड डेव्हिएशन काढणे
    sma = data['close'].rolling(window=window).mean()
    std = data['close'].rolling(window=window).std()
    
    # अप्पर आणि लोअर बँड्स काढणे
    upper_band = sma + (std * num_std)
    lower_band = sma - (std * num_std)
    
    return upper_band, sma, lower_band

def get_bollinger_action(data, upper_band, lower_band):
    last_price = data['close'].iloc[-1]
    last_upper = upper_band.iloc[-1]
    last_lower = lower_band.iloc[-1]
    
    if last_price >= last_upper:
        return "Put Signal: Price hit or exceeded the Upper Band"
    elif last_price <= last_lower:
        return "Buy Signal: Price hit or dropped below the Lower Band"
    else:
        return "No Action: Price is between bands"

